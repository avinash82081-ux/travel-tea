<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#10100e">

<title>Travel Tea | Aurangabad</title>

<meta name="description" content="Order Tea, Coffee, Cold Coffee and Fresh Fruit Glass in Aurangabad. Open 24 Hours. Free Delivery within 5 KM from Balaji Nagar.">

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
--gold:#e8b85b;
--dark:#10100e;
--cream:#fff4df;
--green:#219653;
}

body{
background:var(--dark);
color:var(--cream);
font-family:Arial,sans-serif;
}

header{
position:sticky;
top:0;
z-index:10;
background:#10100eef;
padding:17px 5%;
display:flex;
justify-content:space-between;
align-items:center;
border-bottom:1px solid #ffffff20;
}

.logo{
font-size:23px;
font-weight:900;
color:var(--gold);
letter-spacing:2px;
}

.logo small{
display:block;
font-size:9px;
color:white;
letter-spacing:4px;
}

nav a{
color:white;
text-decoration:none;
margin-left:12px;
font-size:13px;
}

.hero{
padding:65px 6%;
background:radial-gradient(circle at 80% 20%,#79501d66,transparent 40%),#17140f;
display:grid;
grid-template-columns:1fr 1fr;
gap:25px;
align-items:center;
}

.hero h1{
font-size:clamp(42px,7vw,70px);
line-height:1;
margin:20px 0;
}

.hero h1 span{
color:var(--gold);
}

.hero p{
color:#c5b9a4;
line-height:1.8;
}

.gold{
color:var(--gold);
letter-spacing:3px;
font-weight:bold;
font-size:12px;
}

.btn{
display:inline-block;
padding:14px 22px;
border-radius:30px;
text-decoration:none;
font-weight:bold;
margin:18px 5px 0 0;
border:none;
cursor:pointer;
}

.primary{
background:var(--gold);
color:#17120a;
}

.secondary{
border:1px solid var(--gold);
color:white;
background:transparent;
}

.hero-art{
height:290px;
border-radius:25px;
background:linear-gradient(145deg,#493019,#17120b);
display:flex;
justify-content:center;
align-items:center;
flex-direction:column;
border:1px solid #e8b85b66;
}

.hero-art .emoji{
font-size:110px;
}

.hero-art h3{
color:var(--gold);
letter-spacing:3px;
margin-top:15px;
}

.strip{
background:#241b10;
padding:18px 5%;
text-align:center;
color:var(--gold);
font-size:12px;
font-weight:bold;
line-height:2;
}

section{
padding:55px 6%;
}

.heading{
text-align:center;
margin-bottom:30px;
}

.heading h2{
font-size:34px;
margin:12px 0;
}

.heading p{
color:#b9ad98;
}

.menu{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:16px;
}

.card{
background:#211f19;
padding:18px;
border-radius:20px;
border:1px solid #ffffff15;
}

.food{
height:110px;
background:#392a19;
border-radius:15px;
display:flex;
justify-content:center;
align-items:center;
font-size:65px;
}

.card h3{
margin:15px 0 8px;
}

.card p{
font-size:13px;
color:#b9ad98;
min-height:35px;
}

.price-row{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:15px;
}

.price{
font-size:24px;
font-weight:bold;
color:var(--gold);
}

.add{
background:var(--gold);
border:0;
border-radius:20px;
padding:10px 17px;
font-weight:bold;
cursor:pointer;
}

.offer{
margin:0 6%;
padding:25px;
border-radius:20px;
background:linear-gradient(100deg,#76501f,#30200e);
}

.offer h2{
margin-bottom:10px;
}

.offer p{
line-height:1.7;
}

.order-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
}

.box{
background:#211f19;
padding:24px;
border-radius:20px;
border:1px solid #ffffff20;
}

.box h3{
color:var(--gold);
margin-bottom:20px;
}

label{
display:block;
margin:13px 0 7px;
color:#c5b9a4;
font-size:13px;
}

input,textarea{
width:100%;
padding:13px;
border-radius:10px;
border:1px solid #ffffff30;
background:#111;
color:white;
font-size:15px;
}

textarea{
height:80px;
}

.locbtn{
width:100%;
padding:13px;
margin-top:12px;
background:#24432d;
color:#b8f2c8;
border:1px solid #3b8050;
border-radius:10px;
cursor:pointer;
}

.note{
color:#b9ad98;
font-size:12px;
line-height:1.7;
margin-top:10px;
}

.cartline{
display:flex;
justify-content:space-between;
padding:12px 0;
border-bottom:1px solid #ffffff20;
}

.qtybtn{
padding:4px 10px;
margin-left:5px;
cursor:pointer;
}

.total{
display:flex;
justify-content:space-between;
font-size:23px;
font-weight:bold;
color:var(--gold);
margin:22px 0;
}

.whatsapp{
width:100%;
background:#219653;
color:white;
font-size:16px;
}

.map{
width:100%;
height:300px;
border:0;
border-radius:20px;
}

footer{
background:#080807;
text-align:center;
padding:35px 15px;
color:#b9ad98;
line-height:2;
font-size:13px;
}

footer h2{
color:var(--gold);
letter-spacing:4px;
}

.floating{
position:fixed;
bottom:18px;
right:15px;
background:#219653;
color:white;
padding:15px 20px;
border-radius:30px;
text-decoration:none;
font-weight:bold;
z-index:20;
}

@media(max-width:800px){
.hero{grid-template-columns:1fr}
.menu{grid-template-columns:repeat(2,1fr)}
.order-grid{grid-template-columns:1fr}
}

@media(max-width:430px){
.menu{gap:10px}
.card{padding:12px}
.food{height:85px}
.card h3{font-size:16px}
.price{font-size:20px}
nav a{font-size:11px;margin-left:7px}
}
</style>
</head>

<body>

<header>
<div class="logo">
TRAVEL TEA
<small>FRESH • HOT • ON THE GO</small>
</div>

<nav>
<a href="#menu">Menu</a>
<a href="#order">Order</a>
<a href="#location">Location</a>
</nav>
</header>

<!-- HERO -->

<div class="hero">

<div>
<div class="gold">OPEN 24 HOURS • 7 DAYS</div>

<h1>
Your Cravings.<br>
<span>Our Delivery.</span>
</h1>

<p>
Chai ki chuski ho ya chilled coffee ka mood!
Your favourite drinks delivered to your doorstep
anytime, anywhere in Aurangabad.
</p>

<a href="#menu" class="btn primary">ORDER NOW →</a>

<a href="tel:7758981726" class="btn secondary">
CALL NOW
</a>
</div>

<div class="hero-art">
<div class="emoji">☕</div>
<h3>TRAVEL TEA</h3>
</div>

</div>

<div class="strip">
✦ OPEN 24 HOURS &nbsp; ✦ FRESHLY PREPARED
<br>
✦ FREE DELIVERY WITHIN 5 KM FROM BALAJI NAGAR
</div>

<!-- MENU -->

<section id="menu">

<div class="heading">
<div class="gold">OUR MENU</div>
<h2>Choose Your Favourite</h2>
<p>Great Taste. Affordable Prices.</p>
</div>

<div class="menu">

<div class="card">
<div class="food">🍵</div>
<h3>Hot Tea</h3>
<p>Fresh and kadak chai.</p>
<div class="price-row">
<span class="price">₹10</span>
<button class="add" onclick="addItem('Hot Tea',10)">ADD +</button>
</div>
</div>

<div class="card">
<div class="food">☕</div>
<h3>Hot Coffee</h3>
<p>Rich and refreshing coffee.</p>
<div class="price-row">
<span class="price">₹20</span>
<button class="add" onclick="addItem('Hot Coffee',20)">ADD +</button>
</div>
</div>

<div class="card">
<div class="food">🧋</div>
<h3>Cold Coffee</h3>
<p>Chilled creamy cold coffee.</p>
<div class="price-row">
<span class="price">₹30</span>
<button class="add" onclick="addItem('Cold Coffee',30)">ADD +</button>
</div>
</div>

<div class="card">
<div class="food">🍹</div>
<h3>Fresh Fruit Glass</h3>
<p>Fresh and fruity refreshment.</p>
<div class="price-row">
<span class="price">₹40</span>
<button class="add" onclick="addItem('Fresh Fruit Glass',40)">ADD +</button>
</div>
</div>

</div>
</section>

<!-- DELIVERY OFFER -->

<div class="offer">

<h2>🚚 FREE HOME DELIVERY</h2>

<p>
Serving customers across Aurangabad.
<br>
FREE DELIVERY within 5 KM from Balaji Nagar.
<br>
Beyond 5 KM: Delivery charges applicable.
</p>

<a href="#order" class="btn primary">ORDER YOUR FAVOURITE</a>

</div>

<!-- ORDER -->

<section id="order">

<div class="heading">
<div class="gold">QUICK ORDER</div>
<h2>Place Your Order</h2>
<p>Choose your drinks and order directly on WhatsApp.</p>
</div>

<div class="order-grid">

<div class="box">

<h3>1. Delivery Details</h3>

<label>Your Name</label>
<input id="cust" placeholder="Enter your name">

<label>Mobile Number</label>
<input id="phone" type="tel" placeholder="Enter mobile number">

<label>Delivery Address</label>
<textarea id="addr" placeholder="House number, area, landmark"></textarea>

<button class="locbtn" onclick="getLocation()">
📍 SHARE MY CURRENT LOCATION
</button>

<p class="note" id="locstatus">
Allow location permission to share your location.
You can also enter your address manually.
</p>

<label>Special Instructions</label>
<input id="extra" placeholder="Less sugar, call on arrival...">

</div>

<div class="box">

<h3>2. Your Shopping Cart</h3>

<div id="cart">
<p class="note">Your cart is empty. Add something from our menu!</p>
</div>

<div class="total">
<span>Total</span>
<span id="total">₹0</span>
</div>

<button class="btn whatsapp" onclick="sendOrder()">
ORDER ON WHATSAPP →
</button>

<p class="note">
Your order will be sent to Travel Tea WhatsApp.
We will confirm availability and delivery charges.
</p>

</div>
</div>
</section>

<!-- GOOGLE MAP -->

<section id="location">

<div class="heading">
<div class="gold">OUR SERVICE LOCATION</div>
<h2>Serving Across Aurangabad</h2>

<p>
Our delivery starting point is Balaji Nagar, Aurangabad.
Free delivery within 5 KM from Balaji Nagar.
</p>
</div>

<iframe
class="map"
loading="lazy"
src="https://www.google.com/maps?q=Balaji+Nagar+Aurangabad+Maharashtra&output=embed">
</iframe>

<div style="text-align:center">

<a
class="btn primary"
